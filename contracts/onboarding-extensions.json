{
  "format_version": "1.0",
  "artifact_type": "design_only",
  "runtime_loaded": false,
  "enabled": false,
  "execution_guarantee": false,
  "status_note": "这些 JSON 是可评审的设计数据，不是可执行配置、JSON Schema、已实现能力或操作授权。",
  "purpose": "业务初始化与持续补充信息的设计；应在部署后的连接发现基础上推进，不能由历史记录直接生成授权。",
  "principle": "复用已观测事实，只询问当前工作流依赖的缺口，保留未知与冲突，按完整来源重新计算 readiness。",
  "fact_contract": {
    "fields": [
      "value",
      "status",
      "source",
      "observed_at",
      "valid_until",
      "scope"
    ],
    "statuses": [
      "confirmed",
      "observed",
      "hypothesis",
      "unknown",
      "conflict",
      "stale"
    ],
    "validation": "文本事实必须为非空文本，来源必须有可核实说明；false、空对象或数字不能冒充产品名称。结构字段按其声明类型验证。",
    "source_is_not_authorization": true,
    "history": "事实更新形成新业务版本，保留必要变更原因，不把历史方法当当前选择。"
  },
  "connection_snapshot": {
    "fields": [
      "platform",
      "account_reference",
      "ad_product_profile",
      "connector_version",
      "verification_mode",
      "read_scope",
      "write_scope",
      "checked_at",
      "valid_until",
      "evidence_reference"
    ],
    "verification_modes": [
      "simulation",
      "live"
    ],
    "freshness": "使用明确 as_of 检查时间；未来检查时间无效，过期证据必须重新读取。",
    "scope": "发现账户、验证读取和验证写入分开记录；验证必须与本轮平台、账户、产品和动作匹配。",
    "simulation_boundary": "模拟 snapshot 只证明 fixture 或本地协议，不证明线上连接、权限、余额或可发布。"
  },
