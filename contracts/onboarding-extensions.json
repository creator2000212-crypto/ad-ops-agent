    "machine_actions_separate": true,
    "asked_unanswered_state": "unresolved",
    "repetition": "已问未答的同一问题保留 unresolved，不假装已掌握，也不在每轮自动重复；依赖变更或用户要求澄清时可再次提出。",
    "progress_is_not_business_fact": "asked_questions 等对话进度不改变业务事实 hash。",
    "no_global_questionnaire_gate": "资料整理与独立的素材选择可先开展；非依赖未知继续留在 gaps。"
  },
  "readiness_contract": {
    "workflows": [
      "discovery",
      "material_selection",
      "test_planning",
      "publish"
    ],
    "derived_not_trusted": "从当前事实、来源、范围、时间和工作流依赖重新计算；不信输入 JSON 自报 ready。",
    "discovery": "可整理现有事实与缺口，不要求所有业务细节齐全。",
    "material_selection": "检查任务所需素材、产品匹配与限制；不能用缺少无关收入信息一律阻断。",
    "test_planning": "需要明确测试目的、目标事件、账户范围、预算和必要测量口径；只增加当前目标真正依赖的价值事实。",
    "publish": "除计划依赖外，必须检查适用配置、连接读写范围、授权、上下文绑定与当前状态。与发布依赖相关的冲突或过期事实阻断发布。",
    "not_a_runtime_implementation": true
  },
  "context_binding": {
